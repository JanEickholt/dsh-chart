{
  "name": "dsh-chart",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: the show_chart tool lets the agent render statistics as charts (pie, bar, line) inline in the chat row — the model emits a JSON spec, the client draws SVG. No files, no sidebar.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanEickholt/dsh-chart.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-client-id.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'test/*.test.mjs'"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.0",
    "tsdown": "0.22.2",
    "typescript": "~5.9.2"
  },
  "license": "MIT"
}
